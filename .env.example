# Kopiér denne fil til .env, og skriv jeres egen nøgle efter =
# .env er i .gitignore og kommer aldrig med i git. Del ikke nøglen.
# Nøglen oprettes i Rackbeat under Firmaindstillinger > API (kun adgang til ordrer og produkter).
RACKBEAT_API_KEY=
# Valgfri: separat nøgle til lager (GET /products). Tom betyder, at RACKBEAT_API_KEY bruges.
RACKBEAT_LAGER_KEY=
# Valgfri: nøgle til lagerreguleringer (godkendte batches lægges på Hovedlager). Tom betyder, at kalenderen ikke skriver til Rackbeat.
RACKBEAT_SKRIV_KEY=

# KUN LOKALT (node tests/dev_server.mjs): peg på mocken i stedet for Rackbeat. Fjern linjen ved rigtig nøgle.
# RACKBEAT_BASE_URL=http://127.0.0.1:8790
