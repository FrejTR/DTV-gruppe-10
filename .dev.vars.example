# Kopiér denne fil til .dev.vars til lokal udvikling med: npx wrangler pages dev src
# .dev.vars er i .gitignore og kommer aldrig med i git. Skriv aldrig rigtige nøgler i denne fil.
# I Cloudflare sættes værdierne som secrets under Settings > Variables and Secrets, ikke her.

# Rackbeat-nøgle med adgang til ordrer
RACKBEAT_API_KEY=
# Valgfri: separat nøgle til lager (GET /products). Tom betyder, at RACKBEAT_API_KEY bruges.
RACKBEAT_LAGER_KEY=

# Cloudflare Access (kun i produktion, se docs/rackbeat-opsaetning.md)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# KUN LOKALT: slår Access-tjekket fra på localhost og 127.0.0.1. Sæt den aldrig i Cloudflare.
LOKAL_UDVIKLING_UDEN_ACCESS=
# KUN LOKALT: peg på mocken (node tests/mock_rackbeat.js) i stedet for Rackbeat. Virker kun med linjen ovenfor.
RACKBEAT_BASE_URL=
